# Falcon automated test environment (copy to .env.test)
NODE_ENV=test

# Test database — use a dedicated DB, never production
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=falcon_test

# Alternate single-URL form (optional)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/falcon_test

# API / Web (E2E + live integration — Phase B)
FALCON_API_URL=http://localhost:4000
FALCON_WEB_URL=http://localhost:3000
FALCON_TENANT=sgvu

# Generic test users (Phase B — replace with real seeded accounts when needed)
FALCON_TEST_PASSWORD=password123
FALCON_TEST_FACULTY_EMAIL=pooja.varshney@mygyanvihar.com
FALCON_TEST_HOD_EMAIL=hod@mygyanvihar.com
FALCON_TEST_DEAN_EMAIL=dean.isbm@mygyanvihar.com
FALCON_TEST_EXAMCELL_EMAIL=examcell@mygyanvihar.com

# Flags
# FALCON_TEST_DB=1          # Enable DB integration tests (requires migrated test DB)
# FALCON_RESET_DB=1         # Truncate test tables before integration suite
# FALCON_LIVE_API=1         # Phase B: hit running backend
# FALCON_E2E_LIVE=1         # Phase B: browser tests against live servers

JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_EXPIRATION=1d
