{
  "name": "falcon-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "axios": "^1.18.0",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "nativewind": "^4.2.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.8",
    "eas-cli": "^20.2.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start",
    "start:lan": "expo start --host lan",
    "start:web:lan": "expo start --web --host lan -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir /tmp/falcon-mobile-export-ios",
    "export:android": "expo export --platform android --output-dir /tmp/falcon-mobile-export-android",
    "dev:build:android": "eas build -p android --profile development",
    "dev:build:ios": "eas build -p ios --profile development",
    "qa:preview:android": "eas build -p android --profile preview",
    "qa:preview:ios": "eas build -p ios --profile preview",
    "qa:testflight:ios": "eas build -p ios --profile production && eas submit -p ios --profile production"
  },
  "private": true
}
