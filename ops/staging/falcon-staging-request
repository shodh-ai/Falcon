#!/bin/sh
# Install root-owned, mode 0700. The deploy account has only this no-args sudo rule.
set -eu
[ "$#" = 0 ] || exit 64
exec /usr/bin/systemd-run --quiet --pipe --wait --collect --service-type=exec \
  --property=MemoryMax=256M --property=MemorySwapMax=0 --property=CPUQuota=25% \
  --property=Nice=15 --property=IOSchedulingClass=idle --property=RuntimeMaxSec=960 \
  /usr/bin/python3 -I -B /opt/falcon-staging/current/controller.py --request-stdin
