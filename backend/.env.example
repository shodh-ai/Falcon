# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=university_governance

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Allowed Domain for Google SSO
ALLOWED_DOMAIN=mygyanvihar.org

# File Upload Configuration
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=104857600

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@mygyanvihar.org

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=4000
NODE_ENV=development

# Redis (BullMQ background jobs — required for AI submission queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Google Gemini (PDF validation & extraction)
GEMINI_API_KEY=
# Optional override (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
