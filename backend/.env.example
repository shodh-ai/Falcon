# Multi-tenant SaaS
SAAS_BASE_DOMAIN=localhost
DEFAULT_TENANT_SUBDOMAIN=sgvu
# AUTH_PROVIDER=local | keycloak
# HELPDESK_PROVIDER=local | webhook
# HELPDESK_WEBHOOK_URL=

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=university_governance
# DB_SYNCHRONIZE=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Prefer short TTL in production (e.g. 8h). Frontend auth cookie Max-Age is 8h.
JWT_EXPIRATION=8h

# Razorpay (required in production for student fee / hostel / events payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Mock / sandbox settle is OPT-IN only (any NODE_ENV). Required for local smoke without Razorpay.
# NEVER set ALLOW_MOCK_PAYMENTS=true on internet-facing production.
# ALLOW_MOCK_PAYMENTS=true


# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Allowed email domains for Google SSO (tenant settings take precedence; this is a fallback)
ALLOWED_DOMAIN=mygyanvihar.com
# Optional comma-separated extras: ALLOWED_EMAIL_DOMAINS=mygyanvihar.org,mygyanvihar.com

# File Upload — MinIO (S3-compatible, stateless)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=falcon-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Disk fallback when S3_ENDPOINT is unset
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=104857600

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@mygyanvihar.org

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=4000
NODE_ENV=development

# Redis (BullMQ background jobs — required for AI submission queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Google Gemini (PDF validation & extraction)
GEMINI_API_KEY=
# Optional override (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# GST portal / third-party verification (Digital DOFA quotes)
# Leave unset to run in PENDING_CREDENTIALS mode (format + uniqueness still enforced)
GST_API_BASE_URL=
GST_API_KEY=
# Optional path template; default /gstin/{gstin}
# GST_API_VERIFY_PATH=/gstin/

# DoFA Module 4 physical-product verification
# PEM PKCS#8 Ed25519 private key used only to issue subject verification identities.
# Store the production value in a secrets manager and expose it at runtime.
PRODUCT_VERIFICATION_ED25519_PRIVATE_KEY=
PRODUCT_VERIFICATION_ED25519_PUBLIC_KEY=
PRODUCT_VERIFICATION_SIGNING_KEY_VERSION=
# Optional downstream event webhook uses a separate RSA signing key.
PRODUCT_VERIFICATION_EVENT_WEBHOOK_URL=
PRODUCT_VERIFICATION_EVENT_HOST_ALLOWLIST=
PRODUCT_VERIFICATION_EVENT_SIGNING_PRIVATE_KEY=
# Production capture uploads fail closed when no scanner is configured.
PRODUCT_VERIFICATION_CLAMAV_COMMAND=
PRODUCT_VERIFICATION_REQUIRE_MALWARE_SCAN=false
# Optional ffmpeg-compatible command for metadata-stripped analysis derivatives.
PRODUCT_VERIFICATION_FFMPEG_COMMAND=
