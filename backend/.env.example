# Multi-tenant SaaS
SAAS_BASE_DOMAIN=localhost
DEFAULT_TENANT_SUBDOMAIN=sgvu
# AUTH_PROVIDER=local | keycloak
# HELPDESK_PROVIDER=local | webhook
# HELPDESK_WEBHOOK_URL=

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=university_governance
# DB_SYNCHRONIZE=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Allowed email domains for Google SSO (tenant settings take precedence; this is a fallback)
ALLOWED_DOMAIN=mygyanvihar.com
# Optional comma-separated extras: ALLOWED_EMAIL_DOMAINS=mygyanvihar.org,mygyanvihar.com

# File Upload — MinIO (S3-compatible, stateless)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=falcon-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Disk fallback when S3_ENDPOINT is unset
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=104857600

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@mygyanvihar.org

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=4000
NODE_ENV=development

# HR biometric machine webhook (on-prem listener -> cloud)
# HR_BIOMETRIC_API_KEY=your-machine-api-key
# HR_BIOMETRIC_TENANT_ID=a0000000-0000-4000-8000-000000000001
# Legacy JWT biometric-sync route only:
# HR_BIOMETRIC_WEBHOOK_SECRET=your-shared-secret

# Redis (BullMQ background jobs — required for AI submission queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Google Gemini (PDF validation & extraction)
GEMINI_API_KEY=
# Optional override (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
